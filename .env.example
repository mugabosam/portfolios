# Copy to .env.local for local development. Set the same keys in the Vercel
# project settings for production. Everything here is optional.
#
# Messages use no secret: the contact form and the assistant send them to the
# inbox through Web3Forms, using formAccessKey in content/site.ts. See
# docs/launch-guide.md, step 4. Visitor counts need no key either: enable
# Web Analytics in the Vercel project (step 3).

# Optional: a fine-grained personal access token with NO permissions (public
# data only). Lets the contribution graph use GitHub's official GraphQL API.
# Without it, the graph falls back to a public mirror of the same data.
GITHUB_TOKEN=

# Canonical site URL for metadata, sitemap and Open Graph images, e.g.
# https://sammugabo.me once the domain is connected. Not needed on Vercel's
# own address, which Vercel provides as VERCEL_PROJECT_PRODUCTION_URL.
NEXT_PUBLIC_SITE_URL=

# Google Search Console: the content value of its HTML verification tag.
GOOGLE_SITE_VERIFICATION=
