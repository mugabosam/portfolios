# Copy to .env.local for local development. Set the same keys in the Vercel
# project settings for production. Everything here is optional: without a
# RESEND_API_KEY the assistant hands a visitor's message to their email app.

# Resend (https://resend.com): lets the assistant send messages by email.
RESEND_API_KEY=
# Where messages go. Defaults to the address in content/site.ts.
CONTACT_TO_EMAIL=
# Sender. Resend's shared sender works without a verified domain.
CONTACT_FROM_EMAIL="Portfolio <onboarding@resend.dev>"

# Cloudflare Turnstile secret: a spam check on /api/contact. The assistant
# cannot show the Turnstile widget, so when this is set it uses email instead.
TURNSTILE_SECRET_KEY=

# Optional: a fine-grained personal access token with NO permissions (public
# data only). Lets the contribution graph use GitHub's official GraphQL API.
# Without it, the graph falls back to a public mirror of the same data.
GITHUB_TOKEN=

# Canonical site URL for metadata, sitemap and Open Graph images.
# Not needed on Vercel, which provides VERCEL_PROJECT_PRODUCTION_URL.
NEXT_PUBLIC_SITE_URL=

# Visitor counts need no key: enable Web Analytics in the Vercel project.
